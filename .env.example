# PostgreSQL connection string. On Railway this is provided by the Postgres service.
DATABASE_URL=

# Password you type on /admin/login. Use a long, unique passphrase.
ADMIN_PASSWORD=

# Random string (32+ characters) used to sign login cookies.
# Generate one with: openssl rand -base64 48
SESSION_SECRET=

# Public URL of the site, no trailing slash. Example: https://janmacky.com
NEXT_PUBLIC_SITE_URL=
